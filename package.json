{
  "name": "fluent-reader-mcp",
  "version": "0.1.0",
  "description": "Read-only MCP server (stdio) for a local Fluent Reader profile",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "pretest": "npm run build && tsc -p tsconfig.test.json",
    "test": "node --test --test-concurrency=1 \"dist-test/test/**/*.test.js\"",
    "start": "node dist/main.js",
    "package:win": "node node_modules/typescript/bin/tsc -p tsconfig.test.json && node dist-test/installer/build-portable.js",
    "installer:win": "node node_modules/typescript/bin/tsc -p tsconfig.test.json && node dist-test/installer/build-installer.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "koffi": "3.3.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  }
}
